{
  "uid": "chimera-positions-pnl",
  "title": "Positions & PnL",
  "tags": ["chimera", "trading"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "panels": [
    {
      "id": 1,
      "title": "Active Positions Count",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "chimera_active_positions",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Portfolio Heat",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "chimera_portfolio_heat_percent",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 50, "color": "green"},
              {"value": 75, "color": "yellow"},
              {"value": 100, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Jito Health",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "chimera_jito_health",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "UNHEALTHY", "color": "red"}, "1": {"text": "HEALTHY", "color": "green"}}}
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Open Positions",
      "type": "table",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 4},
      "datasource": {
        "type": "postgres",
        "uid": "P4F7F8D3768E4C7A1"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT wallet_address, token_address, strategy, entry_price, entry_amount_sol * current_price / NULLIF(entry_price, 0) AS current_value_sol, unrealized_pnl_sol, opened_at FROM positions WHERE state IN ('ACTIVE', 'EXITING') AND pnl_data_valid = TRUE ORDER BY opened_at DESC LIMIT 50",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "wallet_address": "Wallet",
              "token_address": "Token",
              "strategy": "Strategy",
              "entry_price": "Entry Price",
              "current_value_sol": "Current Value (SOL)",
              "unrealized_pnl_sol": "Unrealized PnL (SOL)",
              "opened_at": "Opened At"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Realized PnL by Wallet (7d)",
      "type": "bargauge",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 4},
      "datasource": {
        "type": "postgres",
        "uid": "P4F7F8D3768E4C7A1"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT wallet_address, SUM(net_pnl_sol) as pnl FROM trades WHERE side = 'SELL' AND status = 'CLOSED' AND pnl_data_valid = TRUE AND created_at > NOW() - INTERVAL '7 days' GROUP BY wallet_address ORDER BY pnl DESC LIMIT 15",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "wallet_address": "Wallet",
              "pnl": "PnL (SOL)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 0, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Exit Targets",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
      "datasource": {
        "type": "postgres",
        "uid": "P4F7F8D3768E4C7A1"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT t.wallet_address, t.token_symbol, et.entry_price, et.profit_targets, et.targets_hit, et.peak_profit_percent, et.stop_loss_price, et.trailing_stop_active, et.remaining_fraction, et.last_updated FROM exit_targets et JOIN trades t ON et.trade_uuid = t.trade_uuid WHERE et.remaining_fraction > 0 ORDER BY et.last_updated DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "wallet_address": "Wallet",
              "token_symbol": "Token",
              "entry_price": "Entry Price",
              "profit_targets": "Profit Targets",
              "targets_hit": "Targets Hit",
              "peak_profit_percent": "Peak Profit %",
              "stop_loss_price": "Stop Loss",
              "trailing_stop_active": "Trailing Stop",
              "remaining_fraction": "Remaining",
              "last_updated": "Last Updated"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Cost Attribution (30d)",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 22},
      "datasource": {
        "type": "postgres",
        "uid": "P4F7F8D3768E4C7A1"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT wallet_address, SUM(pnl_sol) as gross_pnl, SUM(net_pnl_sol) as net_pnl, SUM(jito_tip_sol) as jito_tips, SUM(dex_fee_sol) as dex_fees, SUM(slippage_cost_sol) as slippage, SUM(total_cost_sol) as total_cost FROM trades WHERE side = 'SELL' AND status = 'CLOSED' AND pnl_data_valid = TRUE AND created_at > NOW() - INTERVAL '30 days' GROUP BY wallet_address ORDER BY net_pnl DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "wallet_address": "Wallet",
              "gross_pnl": "Gross PnL (SOL)",
              "net_pnl": "Net PnL (SOL)",
              "jito_tips": "Jito Tips (SOL)",
              "dex_fees": "DEX Fees (SOL)",
              "slippage": "Slippage (SOL)",
              "total_cost": "Total Cost (SOL)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "sol"
        }
      }
    }
  ]
}